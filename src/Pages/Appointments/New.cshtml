@page
@model VisitorManagement.Pages.Appointments.NewModel
@{
    ViewData["Title"] = "New appointment";
}

<div class="page-header">
    <h1 class="page-title">New appointment</h1>
    <a asp-page="./Index" class="btn btn-outline-secondary">@Icons.Svg("calendar", 16) All appointments</a>
</div>
<p class="text-muted">The visitor gets a 6-character access code for the check-in kiosk, or can check in with their mobile number.</p>

<form method="post" class="card card-body">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Visit.VisitorName" class="form-label">Visitor name</label>
            <input asp-for="Visit.VisitorName" class="form-control" />
            <span asp-validation-for="Visit.VisitorName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Visit.Phone" class="form-label">Mobile number @(Model.Fields.Required("appt.phone") ? "" : "(optional)")</label>
            <input asp-for="Visit.Phone" type="tel" class="form-control" required="@Model.Fields.Required("appt.phone")" />
            <div class="form-text">Lets the visitor check in with their phone number instead of the access code.</div>
            <span asp-validation-for="Visit.Phone" class="text-danger"></span>
        </div>
        @if (Model.Fields.Shown("appt.company"))
        {
            <div class="col-md-6">
                <label asp-for="Visit.Company" class="form-label">Company @(Model.Fields.Required("appt.company") ? "" : "(optional)")</label>
                <input asp-for="Visit.Company" class="form-control" required="@Model.Fields.Required("appt.company")" />
                <span asp-validation-for="Visit.Company" class="text-danger"></span>
            </div>
        }
        @if (Model.Fields.Shown("appt.email"))
        {
            <div class="col-md-6">
                <label asp-for="Visit.Email" class="form-label">Email @(Model.Fields.Required("appt.email") ? "" : "(optional)")</label>
                <input asp-for="Visit.Email" class="form-control" required="@Model.Fields.Required("appt.email")" />
                <span asp-validation-for="Visit.Email" class="text-danger"></span>
            </div>
        }
        <div class="col-12">
            <partial name="_HostPicker" model="@(new HostPickerModel(Model.Hosts, Model.Visit.EmployeeId, "appt"))" />
        </div>
        <div class="col-md-4">
            <label asp-for="Visit.Purpose" class="form-label"></label>
            <select asp-for="Visit.Purpose" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Purposes))" class="form-select"></select>
            <span asp-validation-for="Visit.Purpose" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Visit.ExpectedAt" class="form-label"></label>
            <input asp-for="Visit.ExpectedAt" type="datetime-local" class="form-control" />
            <span asp-validation-for="Visit.ExpectedAt" class="text-danger"></span>
        </div>
        @if (Model.Fields.Shown("appt.stay"))
        {
            <div class="col-md-4">
                <partial name="_ExpectedStay" model="@(new ExpectedStayModel(Model.StayMinutes, "appt", Model.StayOptions))" />
            </div>
        }
        @if (Model.Fields.Shown("appt.notes"))
        {
            <div class="col-12">
                <label asp-for="Visit.Notes" class="form-label">Notes for reception @(Model.Fields.Required("appt.notes") ? "" : "(optional)")</label>
                <textarea asp-for="Visit.Notes" class="form-control" rows="2" required="@Model.Fields.Required("appt.notes")"></textarea>
                <span asp-validation-for="Visit.Notes" class="text-danger"></span>
            </div>
        }
    </div>
    <div class="mt-3">
        <button class="btn btn-primary">@Icons.Svg("calendar-plus", 16) Book appointment</button>
        <a asp-page="./Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
