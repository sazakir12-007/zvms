@page
@model VisitorManagement.Pages.Admin.BrandingModel
@{
    ViewData["Title"] = "Branding";
    var preview = new Branding(Model.CompanyName, Model.Tagline, Model.Display, Model.Style, Model.Current.LogoVersion);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Branding</h1>
        <p class="text-muted mb-0 small">The company banner at the top of every page.</p>
    </div>
</div>

<div class="mb-3">
    <div class="small text-muted mb-1">Preview</div>
    <div class="brand-preview banner-@Model.Style.ToString().ToLowerInvariant()">
        <div class="app-brand">
            <partial name="_BrandMark" model="preview" />
        </div>
    </div>
</div>

<form method="post" enctype="multipart/form-data" class="card card-body" style="max-width: 760px;">
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="CompanyName" class="form-label"></label>
            <input asp-for="CompanyName" class="form-control" />
            <span asp-validation-for="CompanyName" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Tagline" class="form-label">Tagline <span class="text-muted fw-normal">(optional)</span></label>
            <input asp-for="Tagline" class="form-control" placeholder="e.g. Visitor Management" />
            <span asp-validation-for="Tagline" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <span class="form-label d-block">Show</span>
            <div class="btn-group w-100" role="group" aria-label="What to show in the banner">
                @foreach (var (value, label) in new[] { (BrandDisplay.LogoAndText, "Logo + text"), (BrandDisplay.LogoOnly, "Logo only"), (BrandDisplay.TextOnly, "Text only") })
                {
                    <input type="radio" class="btn-check" name="Display" id="display-@value" value="@value" checked="@(Model.Display == value)" />
                    <label class="btn btn-outline-primary" for="display-@value">@label</label>
                }
            </div>
        </div>
        <div class="col-md-6">
            <span class="form-label d-block">Banner style</span>
            <div class="btn-group w-100" role="group" aria-label="Banner style">
                @foreach (var (value, label) in new[] { (BannerStyle.Light, "Light"), (BannerStyle.Gradient, "Brand gradient"), (BannerStyle.Dark, "Dark") })
                {
                    <input type="radio" class="btn-check" name="Style" id="style-@value" value="@value" checked="@(Model.Style == value)" />
                    <label class="btn btn-outline-primary" for="style-@value">@label</label>
                }
            </div>
        </div>

        <div class="col-12">
            <label asp-for="Logo" class="form-label">Logo</label>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <input asp-for="Logo" type="file" accept="image/png,image/jpeg,image/gif,image/webp" class="form-control" style="max-width: 360px;" />
                @if (Model.Current.HasLogo)
                {
                    <button class="btn btn-sm btn-outline-danger" asp-page-handler="RemoveLogo" formnovalidate>@Icons.Svg("trash", 14) Remove current logo</button>
                }
            </div>
            <div class="form-text">PNG, JPEG, GIF or WebP, up to 512 KB. A wide logo about 40 px tall works best; transparent PNG looks best on the gradient and dark styles. Without a logo, the built-in mark is shown.</div>
            <span asp-validation-for="Logo" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button class="btn btn-primary">Save branding</button>
    </div>
</form>

@section Scripts {
    <script>
        // Live preview of name, tagline, display and style before saving.
        (function () {
            var preview = document.querySelector('.brand-preview');
            var form = document.querySelector('form[enctype]');
            var name = form.querySelector('[name=CompanyName]');
            var tagline = form.querySelector('[name=Tagline]');
            var logoInput = form.querySelector('[name=Logo]');

            function update() {
                var company = preview.querySelector('.app-brand-company');
                var tag = preview.querySelector('.app-brand-tagline');
                if (company) company.textContent = name.value || 'Your Company';
                if (tag) { tag.textContent = tagline.value; tag.hidden = !tagline.value; }

                var display = form.querySelector('[name=Display]:checked').value;
                var nameBox = preview.querySelector('.app-brand-name');
                var logo = preview.querySelector('.app-logo, .app-logo-img');
                if (nameBox) nameBox.hidden = display === 'LogoOnly';
                if (logo) logo.style.display = display === 'TextOnly' ? 'none' : '';

                var style = form.querySelector('[name=Style]:checked').value.toLowerCase();
                preview.className = 'brand-preview banner-' + style;
            }

            logoInput.addEventListener('change', function () {
                var file = logoInput.files[0];
                if (!file) return;
                var url = URL.createObjectURL(file);
                var logo = preview.querySelector('.app-logo, .app-logo-img');
                var img = document.createElement('img');
                img.className = 'app-logo-img';
                img.alt = '';
                img.src = url;
                if (logo) logo.replaceWith(img); else preview.querySelector('.app-brand').prepend(img);
                update();
            });

            form.addEventListener('input', update);
            form.addEventListener('change', update);
        })();
    </script>
}
