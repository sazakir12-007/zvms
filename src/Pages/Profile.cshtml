@page
@model VisitorManagement.Pages.ProfileModel
@{
    ViewData["Title"] = "My profile";
}

<div class="page-header">
    <h1 class="page-title">My profile</h1>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <form method="post" class="card card-body">
            <div class="d-flex align-items-center gap-3 mb-3">
                <span class="avatar avatar-lg">@Format.Initials(Model.Account.Name)</span>
                <div>
                    <div class="fw-semibold">@Model.Account.Name</div>
                    <div class="small text-muted">@Model.Account.Email · @Model.Account.Role</div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" type="tel" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email (sign-in)</label>
                    <input value="@Model.Account.Email" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Role</label>
                    <input value="@Model.Account.Role" class="form-control" disabled />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary">Save profile</button>
                <a class="btn btn-outline-secondary" asp-page="/Account/ChangePassword" asp-route-returnUrl="@Tenancy.Url("/Profile")">@Icons.Svg("key", 14) Change password</a>
            </div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="card card-body small">
            <div><span class="text-muted">Last signed in:</span> @(Model.Account.LastSignInAt?.ToString("g") ?? "now")</div>
            <div><span class="text-muted">Account created:</span> @Model.Account.CreatedAt.ToString("d")</div>
            <div class="mt-2 text-muted">Your email and role can only be changed by an administrator.</div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
