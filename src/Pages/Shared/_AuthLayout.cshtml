@inject VisitorManagement.Services.SettingsService Settings
@{
    var brand = await Settings.GetBrandingAsync();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] - @brand.CompanyName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth-shell">
        <div class="auth-card">
            <div class="auth-brand">
                <div class="app-brand">
                    <partial name="_BrandMark" model="brand" />
                </div>
            </div>
            @if (TempData["Message"] is string message)
            {
                <div class="alert alert-success" role="status">@message</div>
            }
            @RenderBody()
        </div>
        <p class="auth-foot">Visitors: please use the <a asp-page="/CheckIn">check-in screen</a>.</p>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
