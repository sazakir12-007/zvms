@model CheckInModel
<div class="row g-3">
    <div class="col-md-6">
        <partial name="_Agreement" />
        @Html.ValidationMessage("AcceptAgreement", new { @class = "text-danger d-block" })
    </div>
    @if (Model.Fields.Shown("checkin.signature"))
    {
        <div class="col-md-6">
            <partial name="_SignaturePad" model="Model" />
        </div>
    }
</div>
